# SALF - Secure Academic Ledger Framework
# Root Environment Configuration

# ===========================================
# NETWORK CONFIGURATION
# ===========================================
BESU_RPC_URL=http://localhost:8545
BESU_WS_URL=ws://localhost:8546
CHAIN_ID=1337

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
POSTGRES_USER=salf_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=salf_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://salf_user:change_me_in_production@postgres:5432/salf_db

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# ===========================================
# IPFS CONFIGURATION
# ===========================================
IPFS_API_URL=http://ipfs:5001
IPFS_GATEWAY_URL=http://ipfs:8080

# ===========================================
# JWT AUTHENTICATION
# ===========================================
# Generate a secure key: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# ML SERVICE CONFIGURATION
# ===========================================
ML_SERVICE_URL=http://ml-service:8001
ML_MODEL_NAME=all-MiniLM-L6-v2

# ===========================================
# SMART CONTRACT ADDRESSES
# Update these after deploying contracts
# ===========================================
ACCESS_CONTROL_CONTRACT=0x0DCd1Bf9A1b36cE34237eEaFef220932846BCD82
ACADEMIC_LEDGER_CONTRACT=0x9A676e781A523b5d0C0e43731313A708CB607508
CONTRIBUTION_REGISTRY_CONTRACT=0x0B306BF915C4d645ff596e518fAf3F9669b97016

# ===========================================
# DEPLOYER CONFIGURATION
# Private key for contract deployment (DO NOT USE IN PRODUCTION)
# ===========================================
DEPLOYER_PRIVATE_KEY=0x8f2a55949038a9610f50fb23b5883af3b4ecb3c3bb792cbcefbd1542c692be63
BESU_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
BESU_CHAIN_ID=31337

# ===========================================
# APPLICATION SETTINGS
# ===========================================
APP_NAME=SALF
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ===========================================
# DOCKER CONFIGURATION
# ===========================================
COMPOSE_PROJECT_NAME=salf
