# SALF Backend Environment Configuration

# Application
APP_NAME="SALF - Secure Academic Ledger Framework"
APP_VERSION="1.0.0"
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production-minimum-32-characters

# Database
DATABASE_URL=sqlite+aiosqlite:///./salf.db

# Redis
REDIS_URL=redis://localhost:6379

# Blockchain - Hyperledger Besu
BESU_RPC_URL=http://127.0.0.1:8545
BESU_CHAIN_ID=1337
BESU_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Contract Addresses (populate after deployment)
ACCESS_CONTROL_ADDRESS=
ACADEMIC_CREDIT_ADDRESS=
CONTRIBUTION_REGISTRY_ADDRESS=

# IPFS
IPFS_HOST=127.0.0.1
IPFS_PORT=5001
IPFS_GATEWAY=http://127.0.0.1:8080/ipfs/

# AI/ML
SBERT_MODEL=all-MiniLM-L6-v2
MIN_ABSTRACT_LENGTH=100
NOVELTY_THRESHOLD=0.3
FRAUD_DETECTION_THRESHOLD=0.85

# File Upload
MAX_FILE_SIZE_MB=50
