# SALF - Secure Academic Ledger Framework
# Root Environment Configuration

# ===========================================
# NETWORK CONFIGURATION
# ===========================================
BESU_RPC_URL=http://localhost:8545
BESU_WS_URL=ws://localhost:8546
BESU_CHAIN_ID=31337
CHAIN_ID=31337

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
POSTGRES_USER=salf_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=salf_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://salf_user:change_me_in_production@postgres:5432/salf_db

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# ===========================================
# IPFS CONFIGURATION
# ===========================================
IPFS_API_URL=http://ipfs:5001
IPFS_GATEWAY_URL=http://ipfs:8080

# ===========================================
# JWT AUTHENTICATION
# ===========================================
# Generate a secure key: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# ML SERVICE CONFIGURATION
# ===========================================
ML_SERVICE_URL=http://ml-service:8001
ML_MODEL_NAME=all-MiniLM-L6-v2

# ===========================================
# SMART CONTRACT ADDRESSES
# Update these after deploying contracts
# ===========================================
ACCESS_CONTROL_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
ACADEMIC_CREDIT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
CONTRIBUTION_REGISTRY_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0

# ===========================================
# DEPLOYER CONFIGURATION
# Private key for contract deployment (DO NOT USE IN PRODUCTION)
# ===========================================
BESU_PRIVATE_KEY=0x8f2a55949038a9610f50fb23b5883af3b4ecb3c3bb792cbcefbd1542c692be63
DEPLOYER_PRIVATE_KEY=0x8f2a55949038a9610f50fb23b5883af3b4ecb3c3bb792cbcefbd1542c692be63

# ===========================================
# APPLICATION SETTINGS
# ===========================================
APP_NAME=SALF
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ===========================================
# DOCKER CONFIGURATION
# ===========================================
COMPOSE_PROJECT_NAME=salf
