# SALF Backend - Local Development Environment
# These are overridden by docker-compose environment vars when running in Docker.

# ===========================================
# APPLICATION
# ===========================================
APP_NAME=SALF
APP_VERSION=1.0.0
DEBUG=true

# ===========================================
# SECURITY
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# DATABASE (use localhost when running outside Docker)
# ===========================================
DATABASE_URL=postgresql://salf_user:salf_password@localhost:5432/salf_db

# ===========================================
# REDIS
# ===========================================
REDIS_URL=redis://localhost:6379

# ===========================================
# IPFS (Kubo node exposed on host port 5001)
# ===========================================
IPFS_API_URL=http://localhost:5001
IPFS_GATEWAY_URL=http://localhost:8080

# ===========================================
# BLOCKCHAIN (Besu node exposed on host port 8545)
# ===========================================
BESU_RPC_URL=http://localhost:8545
BESU_CHAIN_ID=31337
BESU_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ===========================================
# SMART CONTRACT ADDRESSES (update after deploying)
# ===========================================
ACCESS_CONTROL_ADDRESS=0x0DCd1Bf9A1b36cE34237eEaFef220932846BCD82
ACADEMIC_CREDIT_ADDRESS=0x9A676e781A523b5d0C0e43731313A708CB607508
CONTRIBUTION_REGISTRY_ADDRESS=0x0B306BF915C4d645ff596e518fAf3F9669b97016

# ===========================================
# ML SERVICE
# ===========================================
ML_SERVICE_URL=http://localhost:8001
ML_MODEL_NAME=all-MiniLM-L6-v2

# ===========================================
# LLM AGENT (Claude)
# ===========================================
ANTHROPIC_API_KEY=your-anthropic-api-key-here
CLAUDE_MODEL=claude-haiku-4-5-20251001
